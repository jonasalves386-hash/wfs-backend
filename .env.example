# Servidor do Painel de Chegadas
PORT=3000
# Origem adicional autorizada pelo CORS. Informe a URL completa do frontend em produção.
FRONTEND_URL=CHANGE_ME
# Tempo limite compartilhado pelas chamadas aos provedores, em milissegundos.
PROVIDER_TIMEOUT_MS=25000

# Voos — FlightRadar / SIGA-Malha
# Implementação atual: o backend acrescenta /siga-flights/public a esta URL base
# e envia SIGA_STREAM_API_KEY no cabeçalho x-api-key.
MALHA_BASE_URL=CHANGE_ME
SIGA_STREAM_API_KEY=CHANGE_ME
# A resposta da Malha pode superar 1 MB e levar mais de 25 segundos para concluir.
SIGA_TIMEOUT_MS=120000
# Intervalo mínimo entre consultas à SIGA e idade a partir da qual o painel
# mostra "ATUALIZAÇÃO INDISPONÍVEL" (milissegundos).
MALHA_REFRESH_INTERVAL_MS=30000
MALHA_STALE_AFTER_MS=300000
# Somente para desenvolvimento/teste manual. Mantenha false para usar a Malha real.
# Quando true, Fonia e REST. também usam dados fictícios.
CHEGADAS_USE_MOCK_FLIGHTS=false
# Opcional: pasta do frontend servida pelo backend (padrão: ../front-end).
# FRONTEND_DIR=/caminho/para/front-end

# Fonia — equipes e indicador "na posição"
# PENDENTE: o código ainda não possui endpoint nem contrato oficial da API da Fonia.
# Enquanto não houver integração, a linha FONIA fica cinza (sem sinalização).
# Estas variáveis ficam reservadas para a futura integração no backend.
# FONIA_API_BASE_URL=CHANGE_ME
# FONIA_STREAM_API_KEY=CHANGE_ME

# REST — atendimento de restauração
# Use "api" somente quando a API estiver configurada. Qualquer outro valor deixa
# a linha REST. cinza (sem sinalização).
REST_PROVIDER=off
# O backend usa as rotas /voos?tipo=chegada e /viagens/buscar nesta URL base.
REST_API_BASE_URL=CHANGE_ME
# Token Bearer. Preencha somente no .env local e mantenha exclusivamente no backend.
REST_API_TOKEN=CHANGE_ME

# Winglet / Smart Fuel — integração ativa (única cadeira sinalizada hoje)
# O contrato real validado usa: /coi/attendances/summary/smart_fuel
# Autenticação: cabeçalho x-api-key usando WINGLET_API_KEY.
# start_date e end_date são parâmetros de cada consulta, não variáveis fixas de ambiente.
WINGLET_API_BASE_URL=https://winglet.app/api
WINGLET_API_KEY="CHANGE_ME"

# Ferramentas opcionais de validação local do painel
CHROME_DEBUG_URL=http://127.0.0.1:9222
PANEL_URL=http://127.0.0.1:3000/

# Integrações futuras já previstas — ainda não consumidas pelo código
# PENDENTE: URLs, autenticação e contratos oficiais de Limpeza, QTU e QTA.
# LIMPEZA_API_BASE_URL=CHANGE_ME
# LIMPEZA_API_TOKEN=CHANGE_ME
# QTU_API_BASE_URL=CHANGE_ME
# QTU_API_TOKEN=CHANGE_ME
# QTA_API_BASE_URL=CHANGE_ME
# QTA_API_TOKEN=CHANGE_ME
# Nomes legados reservados para Smart Fuel; a configuração conhecida da Winglet está acima.
# SMARTF_API_BASE_URL=CHANGE_ME
# SMARTF_API_TOKEN=CHANGE_ME
